# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Ensure VITE_API_URL is empty for production (use relative paths via nginx proxy)
ENV VITE_API_URL=""

# Build the application
RUN npm run build

# Production stage - using unprivileged nginx for OpenShift compatibility
FROM nginxinc/nginx-unprivileged:alpine

# Switch to root for setup
USER root

# Copy custom nginx config
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Add script to inject runtime environment variables
COPY deploy/docker/env.sh /docker-entrypoint.d/40-env.sh
RUN chmod +x /docker-entrypoint.d/40-env.sh

# Create nginx cache and temp directories, make writable for arbitrary UIDs
RUN mkdir -p /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp \
             /var/cache/nginx/fastcgi_temp /var/cache/nginx/uwsgi_temp \
             /var/cache/nginx/scgi_temp /tmp/nginx && \
    chgrp -R 0 /etc/nginx /var/cache/nginx /var/run /tmp/nginx \
               /usr/share/nginx/html /docker-entrypoint.d && \
    chmod -R g=u /etc/nginx /var/cache/nginx /var/run /tmp/nginx \
                 /usr/share/nginx/html /docker-entrypoint.d

# Switch back to non-root
USER 1001

# Expose port
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
